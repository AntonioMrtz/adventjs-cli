{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["vitest/globals", "node"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/__tests__",
    "src/examples",
    "src/templates",
    "src/assets",
    ".vscode",
    "vitest.config.ts"
  ]
}