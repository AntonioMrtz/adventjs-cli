{
  "name": "adventjs-cli",
  "version": "1.7.0",
  "description": " Spin up your AdventJS challenges by @midudev in seconds! 🎄⚡ ",
  "author": {
    "name": "Antonio Martinez Fernandez",
    "email": "antoniomartinezfernandez17@gmail.com",
    "url": "https://github.com/AntonioMrtz/adventjs-cli"
  },
  "homepage": "https://github.com/AntonioMrtz/adventjs-cli#readme",
  "license": "Attribution-NonCommercial-ShareAlike 4.0 International",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntonioMrtz/adventjs-cli.git"
  },
  "main": "dist/index.js",
  "bin": {
    "adventjs": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "start": "tsx src/index.ts && npm run copy:files",
    "get:challenges": "./scripts/get-all-challenges.sh",
    "dev": "DEV=true tsx src/index.ts && npm run copy:files",
    "copy:files": "node scripts/copy-files.js",
    "build": "rm -rf dist/ && tsc && npm run copy:files && rm -rf dist/__tests__",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "prepare": "husky"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "inquirer": "^12.11.0",
    "puppeteer": "^24.29.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "@types/puppeteer": "^5.4.7",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.1.5"
  }
}
