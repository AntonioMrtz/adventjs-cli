{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: init",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/tsx",
      "args": ["${workspaceFolder}/src/index.ts", "init"]
    },
    {
      "name": "Debug: init DEV",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/tsx",
      "args": ["${workspaceFolder}/src/index.ts", "init"],
      "env": {
        "DEV": "true"
      }
    },
    {
      "name": "Debug: g <day>",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/tsx",
      "args": ["${workspaceFolder}/src/index.ts", "g", "1"]
    },
    {
      "name": "Debug: g <day> DEV from outside adventjs-* generated folder",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/tsx",
      "args": ["${workspaceFolder}/src/index.ts", "g", "1"],
      "env": {
        "DEV": "true"
      }
    },
    {
      "name": "Debug: g <day> DEV from inside adventjs-* generated folder",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/tsx",
      "args": ["${workspaceFolder}/src/index.ts", "g", "1"],
      "env": {
        "DEV": "true"
      },
      "cwd": "${workspaceFolder}/adventjs-2024"
    }
  ]
}
